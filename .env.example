# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Canal (meta | twilio | instagram) ──────────────────────
PROVIDER=

# Meta Cloud API — WhatsApp (si PROVIDER=meta)
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
# META_APP_SECRET=              # valida la firma del webhook (app → Configuración → Básica)

# Twilio — WhatsApp (si PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Instagram DM (si PROVIDER=instagram)
# IG_ACCESS_TOKEN=              # Page Access Token con instagram_manage_messages
# IG_VERIFY_TOKEN=
# IG_APP_SECRET=

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development         # development | production
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# PUBLIC_URL=https://tu-app.up.railway.app   # requerida en prod para validar firma Twilio

# ── Pagos (solo la pasarela que elegiste) ──────────────────
# WOMPI_PRIVATE_KEY=            # Colombia (Wompi)
# WOMPI_ENV=production          # production | sandbox
# MP_ACCESS_TOKEN=              # Latinoamérica (MercadoPago)
# STRIPE_SECRET_KEY=            # Global (Stripe)
# PAGOS_MONEDA=                 # solo si difiere del default (Wompi: COP, Stripe: usd)
# PAGOS_PROVIDER=               # fuerza la pasarela si hay varias llaves

# ── Opcionales ─────────────────────────────────────────────
# CLAUDE_MODEL=claude-haiku-4-5  # default; claude-sonnet-5-5 solo si hace falta (más caro)
# MAX_TOKENS=1024
# CONOCIMIENTO_EN_PROMPT=true    # conviene con conocimiento corto y tráfico seguido; con Haiku el prefijo debe pasar de 4.096 tokens para cachear
# ADMIN_PHONE=+57...            # avisos al equipo (leads, tickets, derivaciones, reporte)
# REPORTE_TOKEN=                # habilita GET /reporte?token=...
# REPORTE_TOKEN también protege GET /estado (costo_usd de hoy y del mes, modelos_sin_precio)
# PRECIOS_ARCHIVO=config/precios.json  # corrige precios de APIs sin tocar código

# ── Voz (se cambia aquí, sin tocar código) ─────────────────
# Escucha con OpenAI gpt-4o-mini-transcribe; habla con OpenAI gpt-audio-1.5, voz marin
# (femenina; muestra «O3» de la prueba de oído 2026-09-25), ~USD 0,08/min de voz. Si falla o
# cambia el texto (guarda de fidelidad), respaldo gpt-4o-mini-tts y luego Gemini Kore.
# OPENAI_API_KEY=               # entiende notas de voz + voz de salida (gpt-audio y respaldo)
# GEMINI_API_KEY=               # último respaldo de la voz (requiere ffmpeg). USAR UNA KEY CON
#                               # FACTURACIÓN ACTIVA: en el tier gratis Google puede entrenar con
#                               # los datos (choca con la Ley 1581 frente al cliente)
# TTS_PROVEEDOR=openai-audio    # openai-audio | openai | gemini (los dos últimos: respaldos)
# VOZ_TIMEOUT_TOTAL=45          # segundos máximos para la nota de voz; si vence, sale en texto
# OPENAI_AUDIO_MODELO=gpt-audio-1.5  # solo gpt-audio*
# TTS_VOZ=marin                 # OpenAI: marin, coral, cedar… / Gemini: Kore, Puck, Zephyr…
# OPENAI_TTS_VOZ=marin          # voz solo para OpenAI (gpt-audio y gpt-4o-mini-tts)
# GEMINI_TTS_VOZ=Kore           # voz solo para Gemini (gana sobre TTS_VOZ)
# TTS_MODELO=gpt-4o-mini-tts    # modelo del respaldo OpenAI (Gemini: gemini-3.8-flash-tts por defecto;
#                               # el 2.5 se apaga el 17-nov-2026)
# TTS_INSTRUCCIONES="Habla en español de Colombia, con tono cálido y cercano, como una persona amable que atiende por WhatsApp. Habla de corrido y con soltura: une las frases sin pausas largas, no te detengas en las comas ni entre oraciones, y mantén un ritmo conversacional ágil y continuo. Nada de locutor ni de robot."
#                               # gpt-audio: mensaje system + "di palabra por palabra…" (fija).
#                               # gpt-4o-mini-tts: instructions. Gemini: antepuesta al texto
# STT_PROVEEDOR=openai          # openai | groq (transcripción gratis con GROQ_API_KEY)
# VOZ_MODELO=gpt-4o-mini-transcribe  # modelo de transcripción (Groq: whisper-large-v3)
#   Un modelo o voz de otro proveedor se ignora (default + aviso en el log).
#   Forzar un proveedor sin su key deja al agente sin esa voz (no cae al otro).
#   Al actualizar a v0.7.1 conviene borrar TTS_PROVEEDOR=gemini, TTS_VOZ=Kore, TTS_MODELO,
#   VOZ_MODELO=whisper-large-v3 y CLAUDE_MODEL=claude-sonnet-5 de los .env viejos.
# GROQ_API_KEY=                 # respaldo gratis para notas de voz (console.groq.com)
# PUBLIC_URL también es necesaria para responder en voz (ver Servidor)

# ── Comportamiento ─────────────────────────────────────────
# HUMANIZAR=true                # burbujas cortas con pausas de escritura
# PAUSA_MINUTOS=60              # pausa del bot al derivar a humano
# NOMBRE_HUMANO=un asesor       # cómo llama el bot a quien atiende al derivar ("el barbero", "Carlos")
# MODO_BORRADOR=true            # una persona aprueba cada respuesta antes de enviarse
#                               # (falla cerrado: sin ningún canal válido los borradores quedan pendientes y sin aviso;
#                               # comandos por WhatsApp: ok N / no N / editar N texto)

# ── Modo borrador: canales de aviso (docs/BORRADORES.md) ───
# BORRADOR_CANALES=whatsapp     # por dónde llega cada borrador al equipo, separados por coma: whatsapp, telegram.
#                               # Sin esta variable vale «whatsapp» (como siempre). Con PROVIDER=instagram,
#                               # «whatsapp» no sirve: usa «telegram». Gana la primera decisión de cualquier canal.
# TELEGRAM_TOKEN=               # token del bot (BotFather). Un bot propio por agente y UN solo worker lo consulta
# TELEGRAM_CHAT_ID=             # id del grupo privado de aprobadores (número negativo, p. ej. -1001234567890)
# TELEGRAM_APROBADORES=         # ids numéricos de Telegram de quienes pueden aprobar, separados por coma
#                               # (ej. 123456789,987654321). Vacío = nadie decide y el canal telegram no existe
