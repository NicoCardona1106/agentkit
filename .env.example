# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Canal (meta | twilio | instagram) ──────────────────────
PROVIDER=

# Meta Cloud API — WhatsApp (si PROVIDER=meta)
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
# META_APP_SECRET=              # valida la firma del webhook (app → Configuración → Básica)

# Twilio — WhatsApp (si PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Instagram DM (si PROVIDER=instagram)
# IG_ACCESS_TOKEN=              # Page Access Token con instagram_manage_messages
# IG_VERIFY_TOKEN=
# IG_APP_SECRET=

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development         # development | production
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# PUBLIC_URL=https://tu-app.up.railway.app   # requerida en prod para validar firma Twilio

# ── Pagos (solo la pasarela que elegiste) ──────────────────
# WOMPI_PRIVATE_KEY=            # Colombia (Wompi)
# WOMPI_ENV=production          # production | sandbox
# MP_ACCESS_TOKEN=              # Latinoamérica (MercadoPago)
# STRIPE_SECRET_KEY=            # Global (Stripe)
# PAGOS_MONEDA=                 # solo si difiere del default (Wompi: COP, Stripe: usd)
# PAGOS_PROVIDER=               # fuerza la pasarela si hay varias llaves

# ── Opcionales ─────────────────────────────────────────────
# CLAUDE_MODEL=claude-haiku-4-5  # default; claude-sonnet-5 solo si hace falta (más caro)
# MAX_TOKENS=1024
# ADMIN_PHONE=+57...            # avisos al equipo (leads, tickets, derivaciones, reporte)
# REPORTE_TOKEN=                # habilita GET /reporte?token=...
# REPORTE_TOKEN también protege GET /estado (incluye costo_usd de hoy y del mes)
# PRECIOS_ARCHIVO=config/precios.json  # corrige precios de APIs sin tocar código

# ── Voz (se cambia aquí, sin tocar código) ─────────────────
# OPENAI_API_KEY=               # entiende notas de voz y responde en voz (OpenAI)
# TTS_VOZ=marin                 # alloy, ash, ballad, coral, echo, fable, onyx, nova, sage,
#                               # shimmer, verse, marin, cedar (prueba de oído: marin/coral/cedar)
# TTS_INSTRUCCIONES="Habla en español de Colombia, con tono cálido, cercano y conversacional, a ritmo natural, como una persona amable que atiende por WhatsApp; nada de locutor ni de robot."
# TTS_PROVEEDOR=openai          # openai | gemini (respaldo; GEMINI_API_KEY + ffmpeg)
# STT_PROVEEDOR=openai          # openai | groq (transcripción gratis con GROQ_API_KEY)
# GROQ_API_KEY=                 # respaldo gratis para notas de voz (console.groq.com)
# GEMINI_API_KEY=               # respaldo de la voz de salida
# PUBLIC_URL también es necesaria para responder en voz (ver Servidor)

# ── Comportamiento ─────────────────────────────────────────
# HUMANIZAR=true                # burbujas cortas con pausas de escritura
# PAUSA_MINUTOS=60              # pausa del bot al derivar a humano
# NOMBRE_HUMANO=un asesor       # cómo llama el bot a quien atiende al derivar ("el barbero", "Carlos")
# MODO_BORRADOR=true            # el admin aprueba cada respuesta antes de enviarse
#                               # (requiere ADMIN_PHONE; comandos: ok N / no N / editar N texto)
